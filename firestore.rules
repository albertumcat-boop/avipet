rules_version = '2';
// AVIPET — Firestore Security Rules
// Deploy: firebase deploy --only firestore:rules
// Auth: Firebase Anonymous Auth — signInAnonymously() en firebase-config.js
// Solo usuarios con session Firebase (anónima) pueden leer/escribir.
// Esto bloquea acceso directo desde internet abierto.

service cloud.firestore {
  match /databases/{database}/documents {

    // Función helper reutilizable
    function autenticado() {
      return request.auth != null;
    }

    // Consultas médicas
    match /consultas/{id} {
      allow read: if autenticado();
      allow create, update: if autenticado();
      allow delete: if autenticado();
    }

    // Servicios del catálogo
    match /servicios_maestro/{id} {
      allow read: if autenticado();
      allow write: if autenticado();
    }

    // Insumos del catálogo
    match /insumos_maestro/{id} {
      allow read: if autenticado();
      allow write: if autenticado();
    }

    // Inventario físico
    match /inventario/{id} {
      allow read: if autenticado();
      allow write: if autenticado();
    }

    // Movimientos de inventario (solo crear, nunca borrar)
    match /movimientos_inventario/{id} {
      allow read: if autenticado();
      allow create: if autenticado();
      allow update, delete: if false;
    }

    // Sala de espera
    match /espera/{id} {
      allow read, write: if autenticado();
    }

    // Peluquería/estética
    match /servicios_estetica/{id} {
      allow read, write: if autenticado();
    }
    match /pacientes_peluqueria/{id} {
      allow read: if autenticado();
      allow create, update: if autenticado();
      allow delete: if false;
    }
    match /fidelidad_peluqueria/{id} {
      allow read, write: if autenticado();
    }

    // Fotos QR (transferencias móvil→desktop)
    match /transferencias_fotos/{id} {
      allow read, write: if autenticado();
    }

    // Doctores (PINs)
    match /doctores/{id} {
      allow read: if autenticado();
      allow write: if autenticado();
    }

    // Usuarios de inventario (PINs)
    match /usuarios_inventario/{id} {
      allow read: if autenticado();
      allow write: if autenticado();
    }

    // Configuración del sistema
    match /configuracion/{id} {
      allow read: if autenticado();
      allow create, update: if autenticado();
      allow delete: if false;
    }

    // Auditoría — solo crear (inmutable)
    match /auditoria_sistema/{id} {
      allow read: if autenticado();
      allow create: if autenticado();
      allow update, delete: if false;
    }
    match /auditoria_inventario/{id} {
      allow read: if autenticado();
      allow create: if autenticado();
      allow update, delete: if false;
    }

    // Almuerzo, vacunas, control de descanso
    match /almuerzo/{id}         { allow read, write: if autenticado(); }
    match /control_descanso/{id} { allow read, write: if autenticado(); }
    match /notas_internas/{id}   { allow read, write: if autenticado(); }
    match /encuestas/{id}        { allow read, write: if autenticado(); }

    // Empleados de peluquería
    match /empleados/{id} {
      allow read, write: if autenticado();
    }
    match /empleados_descanso/{id} {
      allow read, write: if autenticado();
    }

    // Finanzas — deudas y préstamos del equipo
    match /deudas/{id} {
      allow read, write: if autenticado();
    }

    // Medicamentos del catálogo
    match /medicamentos_maestro/{id} {
      allow read, write: if autenticado();
    }

    // Compras de insumos
    match /compras_insumos/{id} {
      allow read, write: if autenticado();
    }

    // Registros diarios Cashea
    match /cashea_registros/{id} {
      allow read, write: if autenticado();
    }

    // Planificador semanal de tareas
    match /planificador_tareas/{id} {
      allow read, write: if autenticado();
    }

    // Facturación fiscal
    match /facturas/{id} {
      allow read:   if autenticado();
      allow create: if autenticado();
      allow update: if autenticado();
      allow delete: if false;
    }

    // Correlativos
    match /correlativos/{id} {
      allow read, write: if autenticado();
    }

    // Notas de crédito y débito: solo crear, inmutables
    match /notas_credito/{id} {
      allow read:   if autenticado();
      allow create: if autenticado();
      allow update, delete: if false;
    }
    match /notas_debito/{id} {
      allow read:   if autenticado();
      allow create: if autenticado();
      allow update, delete: if false;
    }

    // Auditoría de facturación: solo crear (bitácora inmutable)
    match /auditoria_facturacion/{id} {
      allow read:   if autenticado();
      allow create: if autenticado();
      allow update, delete: if false;
    }

    // Compras con datos fiscales completos
    match /compras_fiscales/{id} {
      allow read:   if autenticado();
      allow create: if autenticado();
      allow update, delete: if false;
    }

    // Retenciones de IVA
    match /retenciones/{id} {
      allow read:   if autenticado();
      allow create: if autenticado();
      allow update, delete: if false;
    }

    // Sesiones de escáner remoto
    match /scanner_sessions/{id} {
      allow read, write: if autenticado();
    }

    // Documentos de Recursos Humanos
    match /empleados_rh/{id} {
      allow read, write: if autenticado();
    }
    match /documentos_empleados/{id} {
      allow read, write: if autenticado();
    }
    match /tipos_documentos_custom/{id} {
      allow read, write: if autenticado();
    }

    // Permisos y documentos de la empresa
    match /permisos_empresa/{id} {
      allow read, write: if autenticado();
    }

    // Resúmenes diarios (finanzas)
    match /resumenes_diarios/{id} {
      allow read, write: if autenticado();
    }

    // Bloquear todo lo demás
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "firestore.indexes.json",
      "node_modules/**",
      "bridge/**",
      "*.bat",
      "*.sh",
      "*.exe",
      "*.msi",
      "*.zip",
      "INSTRUCCION*"
    ],
    "headers": [
      {
        "source": "**/*.@(js|html|css)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  }
}
